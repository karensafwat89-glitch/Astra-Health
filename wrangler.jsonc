
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astra-health-api",
  "main": "backend/worker.py",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./frontend/dist/",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
